# dependencies
node_modules/

# build output
dist/
.next/
*.tsbuildinfo

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# macOS
.DS_Store

# local env files
.env
.env*.local
.env.production
!.env.example
!.env.production.example

# sensitive files
*.pem
*.key
authority-keypair.json
*-keypair.json
mainnet-*.json

# IDE / tools
.idea/
.vscode/
.claude-settings.json

# Rust build artifacts
target/
*.so

# Vercel
.vercel

# Expo / React Native scaffolding.
# This monorepo is web + backend + Anchor contracts; the Expo tooling that
# produced these belongs to the separate mobile app and has repeatedly
# generated stray files inside the wrong subprojects.
.expo/

# Expo / React Native native build output
korus-mobile/android/
korus-mobile/ios/
korus-mobile/.expo/

# Firebase config — kept local; upload to EAS as a file secret for cloud builds
korus-mobile/google-services.json

# FCM service account key — a real secret, grants send access to Firebase
korus-mobile/fcm-service-account.json
korus-mobile/*-firebase-adminsdk-*.json

# Release signing keys — NEVER commit. Losing these forfeits the ability to
# update the dApp Store listing; committing them lets anyone publish as you.
*.keystore
*.jks
korus-mobile/keystore.properties

# Holds the keystore password in plaintext for EAS uploads — never commit.
korus-mobile/credentials.json
